# Firebase Web SDK config (Project settings → Your apps → Web app). These are
# public identifiers, safe in NEXT_PUBLIC_*. Never put service-account keys here.
# Leave empty to run the app in guest-only mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local development only: connect to `pnpm emulators` instead of the real project.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=

# Firebase Admin (server only; payments and entitlements). One variable: the service-account JSON,
# base64-encoded (preferred on Vercel: `base64 -w0 service-account.json`) or raw JSON for local use.
# Never commit it and never use a NEXT_PUBLIC_ name. The project must match NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Not needed with the emulators (FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST), which are refused on Vercel.
FIREBASE_SERVICE_ACCOUNT=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout kill switch. Leave empty: checkout returns 503. Only the exact value "true" enables it.
# Do not enable until the webhook and entitlement flow are finished and tested.
STRIPE_CHECKOUT_ENABLED=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mino AI (server only, never NEXT_PUBLIC_). Without a key the chat shows a
# friendly "not connected yet" notice. Name is case-sensitive.
GEMINI_API_KEY=
# Optional overrides (put a model first; defaults in lib/ai/server/config.ts).
MINO_AI_PROVIDER=
MINO_MODEL_FAST=
MINO_MODEL_SMART=
