# Sign-in. Set to true to require Firebase login; anything else runs as a local guest.
NEXT_PUBLIC_AUTH_ENABLED=

# Firebase (client). Leave empty to run the app as a local guest preview.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mino AI (server only). Unset = Mino chat shows an "not connected yet" notice.
MINO_AI_PROVIDER=
