rules_version = '2';

// Vocab Brain Firestore Security Rules.
// Every student can read and write only their own data. Nothing is trusted
// from the client except what these rules verify against request.auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // users/{uid}: profile summary + app state (goals, plan, progress).
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && onlyKeys(['uid', 'name', 'email', 'preferredLanguage', 'createdAt', 'updatedAt',
                     'onboardingCompleted', 'targetIELTSScore', 'currentIELTSLevel', 'studyAbroadGoal', 'app']);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && onlyKeys(['uid', 'name', 'email', 'preferredLanguage', 'createdAt', 'updatedAt',
                     'onboardingCompleted', 'targetIELTSScore', 'currentIELTSLevel', 'studyAbroadGoal', 'app']);

      // users/{uid}/vocabulary/{vocabId}: the student's Brain.
      match /vocabulary/{vocabId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.word is string
          && request.resource.data.word.size() > 0
          && request.resource.data.word.size() <= 64;
      }

      // Any future private sub-collection (attempts, results, plans) stays owner-only.
      // (vocabulary is excluded so its validation above can't be bypassed.)
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && collection != 'vocabulary';
      }
    }

    // subscriptions/{uid}: clients may create a free plan for themselves and read it.
    // Upgrades and cancellations are written by the server (Stripe webhook, Admin SDK).
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.plan == 'free'
        && onlyKeys(['userId', 'email', 'plan', 'createdAt']);
      allow update, delete: if false;
    }

    // Shared learning content: readable by everyone, written only by admins
    // through the Firebase console or Admin SDK.
    match /vocabulary/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
