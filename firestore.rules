rules_version = '2';

// Vocab Brain Firestore Security Rules.
// Every student can read and write only their own data. Nothing is trusted
// from the client except what these rules verify against request.auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function validTestSession(sessionId) {
      let d = request.resource.data;
      return d.id == sessionId
        && d.testId is string && d.testId.size() <= 100
        && d.skill in ['listening', 'reading', 'writing', 'speaking']
        && d.status in ['in-progress', 'submitted']
        && d.answers is map
        && d.elapsedSeconds is number && d.elapsedSeconds >= 0 && d.elapsedSeconds <= d.timeLimitSeconds
        && d.keys().hasOnly(['id', 'testId', 'bookId', 'skill', 'status', 'startedAt', 'updatedAt', 'submittedAt',
                             'timeLimitSeconds', 'elapsedSeconds', 'answers', 'flagged', 'currentNumber', 'timedOut', 'result',
                             'responses', 'durations', 'feedback'])
        && (!('responses' in d) || d.responses is map);
    }

    // users/{uid}: profile summary + app state (goals, plan, progress).
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && onlyKeys(['uid', 'name', 'email', 'preferredLanguage', 'createdAt', 'updatedAt',
                     'onboardingCompleted', 'targetIELTSScore', 'currentIELTSLevel', 'studyAbroadGoal', 'app']);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && onlyKeys(['uid', 'name', 'email', 'preferredLanguage', 'createdAt', 'updatedAt',
                     'onboardingCompleted', 'targetIELTSScore', 'currentIELTSLevel', 'studyAbroadGoal', 'app']);

      // users/{uid}/vocabulary/{vocabId}: the student's Brain.
      match /vocabulary/{vocabId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.word is string
          && request.resource.data.word.size() > 0
          && request.resource.data.word.size() <= 64;
      }

      // users/{uid}/testSessions/{sessionId}: IELTS practice attempts.
      // A submitted attempt is final: its answers and score never change. The
      // only later write allowed is adding Mino's Writing/Speaking feedback once.
      match /testSessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validTestSession(sessionId);
        allow update: if isOwner(uid) && validTestSession(sessionId) && (
          (resource.data.status == 'in-progress'
            && request.resource.data.testId == resource.data.testId
            && request.resource.data.skill == resource.data.skill
            && request.resource.data.startedAt == resource.data.startedAt)
          || (resource.data.status == 'submitted'
            && resource.data.skill in ['writing', 'speaking']
            && !('feedback' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedback', 'updatedAt'])));
      }

      // users/{uid}/mino/{memory|conversation}: Mino's short notes and the
      // recent chat. Small by design; the student can read and delete both.
      match /mino/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && (
          (docId == 'memory'
            && request.resource.data.keys().hasOnly(['notes', 'updatedAt'])
            && request.resource.data.notes is list
            && request.resource.data.notes.size() <= 15)
          || (docId == 'conversation'
            && request.resource.data.keys().hasOnly(['messages', 'updatedAt'])
            && request.resource.data.messages is list
            && request.resource.data.messages.size() <= 20));
      }

      // Any future private sub-collection (results, plans, mistakes) stays owner-only.
      // (Collections with their own rules above are excluded so they can't be bypassed.)
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid) && !(collection in ['vocabulary', 'testSessions', 'mino']);
      }
    }

    // subscriptions/{uid}: clients may create a free plan for themselves and read it.
    // Upgrades and cancellations are written by the server (Stripe webhook, Admin SDK).
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.plan == 'free'
        && onlyKeys(['userId', 'email', 'plan', 'createdAt']);
      allow update, delete: if false;
    }

    // Shared learning content: readable by everyone, written only by admins
    // through the Firebase console or Admin SDK.
    match /vocabulary/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
